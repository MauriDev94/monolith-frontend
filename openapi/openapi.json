    "/auth/v1/refresh": {
      "post": {
        "tags": [
          "v1 Auth"
        ],
        "summary": "Refresh Access Token",
        "description": "Issue a new access token from a valid refresh token.\n\nPrecedence: the `refresh_token` HttpOnly cookie wins; the body field is a legacy\nfallback for non-browser clients. The new refresh cookie is always set so the\nbrowser keeps an up-to-date cookie after every rotation.",
        "operationId": "refresh_access_token_auth_v1_refresh_post",
        "parameters": [
          {
            "name": "refresh_token",
            "in": "cookie",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Refresh Token"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "anyOf": [
                  {
                    "$ref": "#/components/schemas/RefreshTokenRequest"
                  },
                  {
                    "type": "null"
                  }
                ],
                "title": "Request"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RefreshTokenResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
