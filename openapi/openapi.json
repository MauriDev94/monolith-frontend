    "/auth/v1/logout": {
      "post": {
        "tags": [
          "v1 Auth"
        ],
        "summary": "Logout User",
        "description": "End the session: revoke every refresh token and clear the cookie.\n\nIdempotent: missing, empty, tampered, or sub-less cookies still return 204 —\nno information leak about whether a valid session existed. CSRF is bounded:\nsee docs/ARCHITECTURE.md §8.1.",
